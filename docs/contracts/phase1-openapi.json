  "components": {
    "schemas": {
      "ClaimRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "edit",
            "title": "Mode",
            "default": "edit"
          },
          "client_instance_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Instance Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_instance_id"
        ],
        "title": "ClaimRequest"
      },
      "Content": {
        "properties": {
          "verified_empty": {
            "type": "boolean",
            "title": "Verified Empty",
            "default": false
          },
          "image_labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 1,
            "title": "Image Labels"
          },
          "shapes": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 10000,
            "title": "Shapes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Content"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportRequest": {
        "properties": {
          "source_alias": {
            "type": "string",
            "const": "inbox",
            "title": "Source Alias",
            "default": "inbox"
          },
          "relative_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50000,
            "minItems": 1,
            "title": "Relative Paths"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "relative_paths"
        ],
        "title": "ImportRequest"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "ProjectCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
            "title": "Slug"
          },
          "task_type": {
            "type": "string",
            "enum": [
              "detection",
              "classification"
            ],
            "title": "Task Type",
            "default": "detection"
          },
          "initial_classes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Initial Classes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "slug",
          "initial_classes"
        ],
        "title": "ProjectCreate"
      },
      "Save": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "expected_state_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected State Revision"
          },
          "class_schema_id": {
            "type": "string",
            "format": "uuid",
            "title": "Class Schema Id"
          },
          "content": {
            "$ref": "#/components/schemas/Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "expected_state_revision",
          "class_schema_id",
          "content"
        ],
        "title": "Save"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
